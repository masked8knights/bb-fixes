+/**
+ * Local-only ACP slash-command handling (no upstream PR).
+ *
+ * BB sends chat text straight through; prime-agent's ACP mode previously had
+ * no command surface, so typing `/plan` was literal text to the model. A small
+ * command set is translated here into a directive prompt plus a session_info
+ * meta update, so common Claude-Code-style commands keep in-session history
+ * instead of being sent as raw text.
+ *
+ * Directory: /plan, /modify, /todo; Diagnostics: /status, /help, /compact;
+ * Model: /effort <level>. Anything else starting with "/" is left as text so
+ * a genuine model mention or custom command is not mangled.
+ */
+function acpSlashCommand(text: string): { cmd: string; arg: string } | undefined {
+	const trimmed = text.trimStart();
+	if (!trimmed.startsWith("/")) return undefined;
+	const match = /^(\/[A-Za-z][A-Za-z0-9_-]*)(?:\s+([\s\S]*))?$/.exec(trimmed);
+	if (!match) return undefined;
+	return { cmd: match[1]!.toLowerCase(), arg: match[2]?.trim() ?? "" };
+}
+
+/** Directive prompt for a recognized slash command, or undefined if unknown. */
+function slashDirective(cmd: string, arg: string): string | undefined {
+	switch (cmd) {
+		case "/plan":
+			return "Create a clear, step-by-step plan for the current task. " +
+				"Do not implement anything yet; list concrete steps, files to touch, and checks. " +
+				(arg ? `Context: ${arg}` : "");
+		case "/modify":
+			return "Describe the requested change precisely first, then implement it in focused steps. " +
+				(arg ? `Change: ${arg}` : "");
+		case "/todo":
+			return "Break the current task into TODO items with checkboxes; keep them concise and ordered. " +
+				(arg ? `Focus: ${arg}` : "");
+		case "/status":
+		case "/help":
+			return undefined; // handled as meta only
+		default:
+			return undefined;
+	}
+}
+
+/**
+ * Split an ACP prompt into command state + the effective text to run.
+ * Recognized directory commands return their directive; meta commands and
+ * unknown commands return the original text so nothing is silently dropped.
+ */
+function splitAcpPrompt(blocks: readonly unknown[]): { text: string; images: ImageContent[]; cmd?: { cmd: string; arg: string }; directive?: string } {
+	const { text, images } = promptContent(blocks);
+	const firstLine = text.split(/\r?\n/)[0] ?? "";
+	const command = acpSlashCommand(firstLine);
+	if (!command?.cmd) return { text, images };
+	const directive = slashDirective(command.cmd, command.arg);
+	if (directive === undefined && command.cmd !== "/status" && command.cmd !== "/help" && command.cmd !== "/compact" && command.cmd !== "/effort") {
+		return { text, images }; // unknown command: keep literal
+	}
+	// Meta commands act as local-only directives we handle without the model
+	// only when there is no argument text; otherwise fall through to prompt.
+	return { text: directive ?? text, images, cmd: command, directive };
+}
